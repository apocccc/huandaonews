# ===== データベース (Supabase Postgres) =====
# アプリ実行用: Transaction pooler (ポート6543)。
# 注意: pgbouncer=true と connection_limit=10 を必ず付ける
#  - 直結 db.<ref>.supabase.co は IPv6 専用のため Vercel から接続不可 → pooler を使う
#  - connection_limit=1 だとビルドの並列静的生成で pool timeout する
#  - パスワードに記号がある場合は URL エンコードする(または英数字のみにする)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&sslmode=require"

# マイグレーション用: Session pooler (ポート5432)
DIRECT_DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require"

# ===== サイトURL =====
NEXT_PUBLIC_SITE_URL="https://huandaonews.tw"
# 公開画像のカスタムドメイン (R2)
NEXT_PUBLIC_IMG_HOST="img.huandaonews.tw"

# ===== 認証 =====
# `openssl rand -base64 32` で生成
AUTH_SECRET=""
# プレビューURL署名用
PREVIEW_SECRET=""

# ===== Cloudflare R2 (公開画像ストレージ) =====
# R2_* が揃っていると R2 に保存(なければ Vercel Blob → ローカルの順にフォールバック)
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="huandaonews-public"
# カスタムドメインの公開URL(末尾スラッシュなし)
R2_PUBLIC_BASE_URL="https://img.huandaonews.tw"

# ===== Vercel Blob (R2を使わない場合の代替) =====
BLOB_READ_WRITE_TOKEN=""

# ===== OpenAI (AI独自記事化) =====
OPENAI_API_KEY=""
# 省略時 gpt-4o-mini
OPENAI_MODEL=""
# 互換エンドポイントを使う場合のみ (Azure等)
OPENAI_BASE_URL=""

# ===== Cron 認証 (Vercel Cron からの呼び出し保護) =====
CRON_SECRET=""

# ===== Google Analytics (GA4) =====
# 設定すると公開サイトに計測タグが出力される (管理画面は対象外)
NEXT_PUBLIC_GA_ID=""

# ===== Resend (メール送信・将来のニュースレター等) =====
RESEND_API_KEY=""

# ===== 本番初期化用 (db:seed:prod で使用) =====
SEED_ADMIN_EMAIL="admin@huandaonews.tw"
SEED_ADMIN_PASSWORD=""
