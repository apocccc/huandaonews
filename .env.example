# PostgreSQL 接続文字列 (Vercel Postgres / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/huandaonews"

# 公開サイトのURL(末尾スラッシュなし)
NEXT_PUBLIC_SITE_URL="https://huandaonews.com"

# Auth.js のシークレット (`openssl rand -base64 32` で生成)
AUTH_SECRET=""

# Vercel Blob(画像アップロード)
BLOB_READ_WRITE_TOKEN=""

# Vercel Cron からの呼び出し認証用
CRON_SECRET=""

# プレビューURL署名用シークレット
PREVIEW_SECRET=""

# OpenAI API(RSS取り込み記事の「AI独自記事化」に使用)
OPENAI_API_KEY=""
# 使用モデル(省略時 gpt-4o-mini)
OPENAI_MODEL=""
